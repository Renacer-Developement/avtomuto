interface Shape {
  tag: 'path' | 'circle' | 'rect' | 'line' | 'polygon';
  attrs: Record<string, string | number>;
  filled?: boolean;
}

interface IconDef {
  viewBox?: string;
  shapes: Shape[];
}

interface Props {
  name: string;
  size?: number;
  class?: string;
}

