---
const stats = [
  { value: '10', label: 'напрямків послуг під одним дахом' },
  { value: '11', label: 'досвідчених майстрів своєї справи' },
  { value: '24/7', label: 'виклик евакуатора без вихідних' },
  { value: 'Львівська обл.', label: 'вся зона обслуговування' },
];
---

<section class="stats" aria-label="AvtoMuto у цифрах" data-animate>
  <div class="container stats__grid">
    {stats.map((s, i) => (
      <div class="stats__card">
        <span class="stats__index">{String(i + 1).padStart(2, '0')}</span>
        <span class="stats__value">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    background: var(--color-black-deep);
    padding-block: var(--space-7);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 768px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats__card {
    padding: var(--space-5) var(--space-4) var(--space-4);
    border-top: 2px solid var(--color-accent);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .stats__card:not(:first-child) {
      border-left: 1px solid #2a2a2a;
    }
  }

  .stats__index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #777;
  }

  .stats__value {
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.1;
  }

  .stats__label {
    color: #a8a8a8;
    font-size: var(--fs-sm);
    max-width: 22ch;
  }
</style>
