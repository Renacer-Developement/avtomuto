---
import Icon from './Icon.astro';

const stats = [
  { icon: 'wrench', value: '10', label: 'напрямків послуг під одним дахом' },
  { icon: 'team', value: '11', label: 'досвідчених майстрів своєї справи' },
  { icon: 'clock', value: '24/7', label: 'виклик евакуатора без вихідних' },
  { icon: 'region', value: 'Львівська обл.', label: 'вся зона обслуговування' },
];
---

<section class="stats" aria-label="AvtoMuto у цифрах" data-animate>
  <div class="container stats__grid">
    {stats.map((s) => (
      <div class="stats__card">
        <span class="stats__icon">
          <Icon name={s.icon} size={26} />
        </span>
        <span class="stats__value">{s.value}</span>
        <span class="stats__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    background: var(--color-black);
    padding-block: var(--space-7);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 768px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats__card {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    transition: background var(--transition-base);
  }

  @media (min-width: 768px) {
    .stats__card:not(:first-child) {
      border-left: 1px solid #2a2a2a;
    }
  }

  .stats__card:hover {
    background: #1e1e1e;
  }

  .stats__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-white);
  }

  .stats__value {
    font-size: var(--fs-2xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.1;
  }

  .stats__label {
    color: #a8a8a8;
    font-size: var(--fs-sm);
    max-width: 22ch;
  }
</style>
