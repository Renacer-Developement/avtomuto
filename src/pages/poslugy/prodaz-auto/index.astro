---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import CarCatalog from '../../../components/CarCatalog.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import { TEAM, telHref } from '../../../data/site';
import { getCarListings } from '../../../lib/cars';
import { serviceSchema, breadcrumbSchema, faqSchema, carItemListSchema } from '../../../utils/schema';

// Пререндер вимкнено, щоб дані про авто (статус, ціна) підхоплювались з Hygraph
// свіжими через Vercel ISR (astro.config.mjs), а не застигали в білді до наступного деплою.
export const prerender = false;

const service = getServiceBySlug('prodaz-auto')!;
const responsible = TEAM[service.responsible];
const path = '/poslugy/prodaz-auto';
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: path },
];
const schema = [breadcrumbSchema(crumbs), serviceSchema(service, path)];
const faq = faqSchema(service.faq);
if (faq) schema.push(faq);

const cars = await getCarListings();
// Список авто (без проданих) для Google — щоб каталог читався як перелік конкретних пропозицій.
schema.push(carItemListSchema(cars.filter((c) => c.status !== 'sold')));

// Той самий патерн, що й на сторінках авто: «Автомито Рудники» + міста, без суфікса « — AvtoMuto».
const title = 'Авто в наявності — Автомито Рудники: Львів, Стрий, Дрогобич';
const description =
  'Перевірені авто з-за кордону та б/в в Автомито (AvtoMuto), с. Рудники — для покупців зі Львова, Стрия й Дрогобича. Телефонуйте, підготуємо авто до огляду!';
---

<Layout title={title} description={description} path={path} schema={schema} serviceSlug={service.slug} titleSuffix={false}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="container hero" data-animate>
    <span class="index-mark hero__index" aria-hidden="true">01</span>
    <p class="eyebrow"><Icon name={service.icon} size={16} /> Каталог</p>
    <h1>Автомобілі в наявності — купити в Рудниках</h1>
    <p class="lead">{service.shortDescription}</p>
    <div class="hero__cta-group">
      <a href={telHref(responsible.phone)} class="btn btn-primary hero__cta" tabindex="-1" data-gtm-event="click_phone" data-team-member={responsible.name}>
        <Icon name="phone" size={18} /> {responsible.phoneDisplay}
      </a>
    </div>
  </section>

  <section class="container catalog-page" data-animate>
    <CarCatalog cars={cars} responsible={responsible} />
  </section>

  <section class="container">
    <FaqAccordion items={service.faq} />
  </section>

  {service.related && <RelatedServices slugs={service.related} />}
</Layout>

<style>
  /* Герой прихований візуально на всіх екранах, але лишається в DOM (h1, текст, номер)
     для SEO та скрінрідерів. Не display:none — цей прийом (sr-only) надійніше для індексації. */
  .hero {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .catalog-page {
    position: relative;
    padding-block: var(--space-6) var(--space-8);
  }

  @media (max-width: 767px) {
    .catalog-page {
      padding-top: var(--space-5);
    }
  }
</style>
