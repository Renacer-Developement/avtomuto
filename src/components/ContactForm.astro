---
---

<form class="contact-form" data-contact-form novalidate>
  <div class="field">
    <label for="name">Ім'я *</label>
    <input type="text" id="name" name="name" required minlength="2" autocomplete="name" />
    <span class="field__error" data-error-for="name"></span>
  </div>

  <div class="field">
    <label for="phone">Телефон *</label>
    <input type="tel" id="phone" name="phone" required pattern="^[+0-9 ()-]{7,20}$" autocomplete="tel" placeholder="+380 XX XXX XX XX" />
    <span class="field__error" data-error-for="phone"></span>
  </div>

  <div class="field">
    <label for="topic">Тема звернення *</label>
    <select id="topic" name="topic" required>
      <option value="">Оберіть тему</option>
      <option>Ремонт автомобілів</option>
      <option>Автозапчастини</option>
      <option>Продаж коліс</option>
      <option>Сертифікація автомобілів</option>
      <option>Розмитнення</option>
      <option>Пригон автомобілів</option>
      <option>Продаж авто</option>
      <option>Мийка та детейлінг</option>
      <option>Евакуатор</option>
      <option>Інше питання</option>
    </select>
    <span class="field__error" data-error-for="topic"></span>
  </div>

  <div class="field">
    <label for="message">Повідомлення</label>
    <textarea id="message" name="message" rows="4"></textarea>
  </div>

  <button type="submit" class="btn btn-primary contact-form__submit">Надіслати заявку</button>
  <p class="contact-form__note">Повідомлення надійде напряму відповідальному в Telegram/Viber.</p>
</form>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-4);
    max-width: 480px;
  }

  .field {
    display: grid;
    gap: var(--space-1);
  }

  .field label {
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.7rem var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-accent);
  }

  .field.is-invalid input,
  .field.is-invalid select {
    border-color: #d33;
  }

  .field__error {
    display: none;
    color: #d33;
    font-size: var(--fs-sm);
  }

  .field.is-invalid .field__error {
    display: block;
  }

  .contact-form__submit {
    justify-self: start;
  }

  .contact-form__note {
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
    margin: 0;
  }

  .toast {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%) translateY(-150%);
    background: var(--color-black);
    color: var(--color-white);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-accent);
    z-index: 400;
    transition: transform var(--transition-base);
    max-width: 90vw;
  }

  .toast.is-visible {
    transform: translateX(-50%) translateY(0);
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]');
  const toast = document.querySelector('[data-toast]');

  // position:fixed is contained by the nearest ancestor with a transform (the
  // scroll-fade-in [data-animate] sections set one), so move the toast to
  // <body> to keep it truly fixed to the viewport instead of the section.
  if (toast) document.body.appendChild(toast);

  function showToast(message, isError) {
    if (!toast) return;
    toast.textContent = message;
    toast.style.borderLeftColor = isError ? '#d33' : 'var(--color-accent)';
    toast.classList.add('is-visible');
    setTimeout(() => toast.classList.remove('is-visible'), 4000);
  }

  function validateField(field) {
    const wrapper = field.closest('.field');
    const errorEl = wrapper?.querySelector('.field__error');
    const valid = field.checkValidity();
    wrapper?.classList.toggle('is-invalid', !valid);
    if (errorEl) {
      errorEl.textContent = valid ? '' : field.validationMessage;
    }
    return valid;
  }

  if (form) {
    const fields = form.querySelectorAll('input[required], select[required]');
    fields.forEach((field) => {
      field.addEventListener('input', () => validateField(field));
      field.addEventListener('blur', () => validateField(field));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let allValid = true;
      fields.forEach((field) => {
        if (!validateField(field)) allValid = false;
      });
      if (!allValid) return;

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      const submitBtn = form.querySelector('.contact-form__submit');
      submitBtn?.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('request failed');
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_submit', form_topic: payload.topic });
        showToast('Дякуємо! Ваша заявка надіслана — скоро зв’яжемось.', false);
        form.reset();
      } catch (err) {
        showToast('Не вдалося надіслати заявку. Зателефонуйте нам напряму.', true);
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });
  }
</script>
