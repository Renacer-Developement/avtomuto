---
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CarCard from '../../../../components/CarCard.astro';
import RelatedServices from '../../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../../data/services';
import { TEAM, telHref } from '../../../../data/site';
import { getCarListings, brandSlug } from '../../../../lib/cars';
import { serviceSchema, breadcrumbSchema } from '../../../../utils/schema';

// Пререндер вимкнено, щоб список і статус авто по марці підхоплювались з Hygraph
// свіжими через Vercel ISR (astro.config.mjs), а не застигали в білді до наступного деплою.
export const prerender = false;

const allCarsForSlug = await getCarListings();
const brand = allCarsForSlug.map((c) => c.name).find((name) => brandSlug(name) === Astro.params.brand);
if (!brand) {
  return Astro.redirect('/404');
}
const cars = allCarsForSlug.filter((c) => c.name === brand);

const service = getServiceBySlug('prodaz-auto')!;
const responsible = TEAM[service.responsible];
const path = `/poslugy/prodaz-auto/marka/${brandSlug(brand)}`;

const title = `Автомобілі ${brand} — Автомито Рудники, Львів`;
const description = `${brand} в наявності: ${cars.length} авто. Перевірені, розмитнені автомобілі ${brand}, готові до реєстрації. Автомито (AvtoMuto), с. Рудники — для покупців зі Львова, Стрия, Дрогобича, Миколаєва та Городка.`;

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: '/poslugy/prodaz-auto' },
  { label: brand, href: path },
];
const schema = [breadcrumbSchema(crumbs), serviceSchema({ ...service, title, description }, path)];

const otherBrands = [...new Set(allCarsForSlug.map((c) => c.name).filter((n) => n !== brand))].sort();
---

<Layout title={title} description={description} path={path} schema={schema} serviceSlug={service.slug}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="container catalog-page" data-animate>
    <p class="eyebrow">Продаж авто</p>
    <h1>Автомобілі {brand}</h1>
    <p class="lead">
      {cars.length} {cars.length === 1 ? 'автомобіль' : 'автомобілі'} {brand} в наявності — перевірені технічно,
      розмитнені та готові до реєстрації. Оглянути можна особисто на СТО в с. Рудники.
    </p>
  </section>

  <section class="container">
    <div class="brand-catalog__grid">
      {cars.map((car) => (
        <CarCard car={car} layout="grid" />
      ))}
    </div>
  </section>

  {otherBrands.length > 0 && (
    <section class="container other-brands" data-animate>
      <h2>Інші марки в наявності</h2>
      <div class="other-brands__list">
        <a href="/poslugy/prodaz-auto">Весь каталог</a>
        {otherBrands.map((b) => (
          <a href={`/poslugy/prodaz-auto/marka/${brandSlug(b)}`}>{b}</a>
        ))}
      </div>
    </section>
  )}

  {service.related && <RelatedServices slugs={service.related} />}
</Layout>

<style>
  .catalog-page {
    padding-block: var(--space-6) var(--space-4);
  }

  .lead {
    color: var(--color-gray-mid);
    max-width: 65ch;
  }

  .brand-catalog__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    padding-block: var(--space-4);
  }

  @media (min-width: 640px) {
    .brand-catalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .other-brands {
    padding-block: var(--space-4) var(--space-6);
  }

  .other-brands__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .other-brands__list a {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-black);
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .other-brands__list a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
