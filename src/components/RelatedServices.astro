---
import Icon from './Icon.astro';
import { getServiceBySlug } from '../data/services';

interface Props {
  slugs: string[];
  heading?: string;
}

const { slugs, heading = 'Суміжні послуги' } = Astro.props;
const items = slugs
  .map((slug) => getServiceBySlug(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---

{items.length > 0 && (
  <section class="related-services container" data-animate>
    <h2>{heading}</h2>
    <div class="related-services__list">
      {items.map((service) => (
        <a href={`/poslugy/${service.slug}`} class="related-services__card">
          <span class="related-services__icon"><Icon name={service.icon} size={20} /></span>
          <span>
            <strong>{service.title}</strong>
            <span class="related-services__desc">{service.shortDescription}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-services {
    padding-block: var(--space-5) var(--space-6);
  }

  .related-services__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .related-services__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-services__card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .related-services__card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .related-services__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--color-gray-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .related-services__card strong {
    display: block;
    margin-bottom: 2px;
  }

  .related-services__desc {
    display: block;
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }
</style>
