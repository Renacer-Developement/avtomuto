---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { TeamMember } from '../data/site';
import { telHref, waHref, viberHref, tgHref } from '../data/site';
import type { ImageMetadata } from 'astro';

interface Props {
  member: TeamMember;
  photo?: ImageMetadata;
}

const { member, photo } = Astro.props;
---

<div class="team-row" data-animate>
  {photo && (
    <div class="team-row__photo">
      <Image
        src={photo}
        alt={`${member.name} — ${member.role}, AvtoMuto`}
        width={160}
        height={160}
        format="avif"
        quality={80}
        fit="cover"
        position="top"
      />
    </div>
  )}
  <div class="team-row__info">
    <p class="team-row__name">{member.name}</p>
    <p class="team-row__role">{member.role}</p>
  </div>
  <div class="team-row__actions">
    <a href={telHref(member.phone)} class="team-row__call" data-gtm-event="click_phone" data-team-member={member.name}>
      <Icon name="phone" size={18} /> {member.phoneDisplay}
    </a>
    <div class="team-row__messengers">
      <a href={waHref(member.phone)} aria-label={`WhatsApp ${member.name}`} data-gtm-event="click_messenger" data-team-member={member.name} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={20} />
      </a>
      <a href={viberHref(member.phone)} aria-label={`Viber ${member.name}`} data-gtm-event="click_messenger" data-team-member={member.name}>
        <Icon name="viber" size={20} />
      </a>
      <a href={tgHref(member.phone)} aria-label={`Telegram ${member.name}`} data-gtm-event="click_messenger" data-team-member={member.name} target="_blank" rel="noopener noreferrer">
        <Icon name="telegram" size={20} />
      </a>
    </div>
  </div>
</div>

<style>
  .team-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .team-row__photo {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    overflow: hidden;
  }

  .team-row__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-row__info {
    flex: 1;
    min-width: 180px;
  }

  .team-row__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    margin-bottom: 2px;
  }

  .team-row__role {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .team-row__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .team-row__call {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .team-row__call:hover {
    color: var(--color-accent-dark);
  }

  .team-row__messengers {
    display: flex;
    gap: var(--space-3);
    padding-left: var(--space-4);
    border-left: 1px solid var(--color-border);
  }

  .team-row__messengers a {
    color: var(--color-gray-mid);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .team-row__messengers a:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .team-row__actions {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
