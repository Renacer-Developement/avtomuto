---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { TeamMember } from '../data/site';
import { telHref, waHref, viberHref, tgHref } from '../data/site';
import type { ImageMetadata } from 'astro';

interface Props {
  member: TeamMember;
  photo?: ImageMetadata;
}

const { member, photo } = Astro.props;
const initial = member.name.charAt(0);
---

<div class="team-card" data-animate>
  <div class="team-card__photo">
    {photo ? (
      <div class="offset-block">
        <Image
          src={photo}
          alt={`${member.name} — ${member.role}, AvtoMuto`}
          width={320}
          height={400}
          format="avif"
          quality={80}
          fit="cover"
          position="top"
        />
      </div>
    ) : (
      <div class="team-card__photo-placeholder" aria-hidden="true">
        <span>{initial}</span>
      </div>
    )}
  </div>
  <h3 class="team-card__name">{member.name}</h3>
  <p class="team-card__role">{member.role}</p>
  <div class="team-card__actions">
    <a href={telHref(member.phone)} class="btn btn-primary team-card__call" data-gtm-event="click_phone">
      <Icon name="phone" size={16} /> {member.phoneDisplay}
    </a>
    <div class="team-card__messengers">
      <a href={waHref(member.phone)} aria-label={`WhatsApp ${member.name}`} data-gtm-event="click_messenger" target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={20} />
      </a>
      <a href={viberHref(member.phone)} aria-label={`Viber ${member.name}`} data-gtm-event="click_messenger">
        <Icon name="viber" size={20} />
      </a>
      <a href={tgHref(member.phone)} aria-label={`Telegram ${member.name}`} data-gtm-event="click_messenger" target="_blank" rel="noopener noreferrer">
        <Icon name="telegram" size={20} />
      </a>
    </div>
  </div>
</div>

<style>
  .team-card {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .team-card__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    margin: 0 0 var(--space-4);
    background: var(--color-gray-light);
  }

  .team-card__photo .offset-block,
  .team-card__photo img {
    width: 100%;
    height: 100%;
  }

  .team-card__photo img {
    object-fit: cover;
    display: block;
  }

  .team-card__photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-black);
  }

  .team-card__photo-placeholder span {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(3.5rem, 3rem + 3vw, 5rem);
    color: var(--color-accent);
    line-height: 1;
  }

  .team-card__name {
    margin-bottom: var(--space-1);
  }

  .team-card__role {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
    min-height: 2.6em;
  }

  .team-card__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .team-card__call {
    width: 100%;
    justify-content: center;
  }

  .team-card__messengers {
    display: flex;
    gap: var(--space-3);
  }

  .team-card__messengers a {
    color: var(--color-accent);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .team-card__messengers a:hover {
    color: var(--color-accent-dark);
    transform: translateY(-2px);
  }
</style>
