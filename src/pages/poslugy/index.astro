---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import EvakuatorBanner from '../../components/EvakuatorBanner.astro';
import { SERVICES } from '../../data/services';
import { breadcrumbSchema } from '../../utils/schema';

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
];
const gridServices = SERVICES.filter((s) => !s.highlight);
---

<Layout
  title="Послуги AvtoMuto — ремонт, СТО, продаж авто, евакуатор"
  description="Усі послуги AvtoMuto в Рудниках: ремонт авто, автозапчастини, продаж коліс, сертифікація, пригон авто, продаж авто, мийка та детейлінг, евакуатор 24/7."
  path="/poslugy"
  schema={breadcrumbSchema(crumbs)}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="container" data-animate>
    <p class="eyebrow">AvtoMuto</p>
    <h1>Наші послуги</h1>
    <p class="lead">Вісім напрямків роботи AvtoMuto — від планового ТО до термінового виклику евакуатора.</p>
    <div class="grid">
      {gridServices.map((s, i) => (
        <ServiceCard service={s} index={i} />
      ))}
    </div>
  </section>

  <EvakuatorBanner />
</Layout>

<style>
  section {
    padding-block: var(--space-6);
  }

  .lead {
    color: var(--color-gray-mid);
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .grid {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 800px) {
    .grid {
      column-count: 2;
      column-gap: var(--space-6);
    }
  }
</style>
