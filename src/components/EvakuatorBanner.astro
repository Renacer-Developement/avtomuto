---
import Icon from './Icon.astro';
import { TEAM, telHref } from '../data/site';
---

<section class="evakuator-banner" aria-label="Виклик евакуатора" data-animate>
  <div class="container evakuator-banner__inner">
    <div class="evakuator-banner__icon">
      <Icon name="tow-truck" size={56} />
    </div>
    <div class="evakuator-banner__text">
      <h2>Потрібен евакуатор? Працюємо 24/7</h2>
      <p>Виїжджаємо по всій Львівській області — Рудники, Стрий, Дрогобич, Львів та інші населені пункти. Дзвоніть прямо зараз.</p>
    </div>
    <a href={telHref(TEAM.andriy.phone)} class="btn btn-primary evakuator-banner__cta" data-gtm-event="click_phone">
      <Icon name="phone" size={20} />
      Викликати евакуатор
    </a>
  </div>
</section>

<style>
  .evakuator-banner {
    background: var(--color-black);
    color: var(--color-white);
    border-top: 4px solid var(--color-accent);
    border-bottom: 4px solid var(--color-accent);
    padding-block: var(--space-5);
  }

  .evakuator-banner__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .evakuator-banner__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 20px;
    background: var(--color-accent);
    line-height: 0;
  }

  .evakuator-banner__text {
    flex: 1 1 320px;
  }

  .evakuator-banner__text h2 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-1);
  }

  .evakuator-banner__text p {
    color: #d9d9d9;
    margin: 0;
    font-size: var(--fs-sm);
  }

  .evakuator-banner__cta {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>
