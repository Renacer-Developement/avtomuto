---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import Icon from '../../../components/Icon.astro';
import ContactCard from '../../../components/ContactCard.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import { KOLISA_CITIES } from '../../../data/kolisa-cities';
import { TEAM, telHref } from '../../../data/site';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../utils/schema';

export function getStaticPaths() {
  return KOLISA_CITIES.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const kolisa = getServiceBySlug('prodazh-kolis')!;
const responsible = TEAM[kolisa.responsible];
const path = `/poslugy/prodazh-kolis/${city.slug}`;

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: kolisa.title, href: '/poslugy/prodazh-kolis' },
  { label: city.name, href: path },
];

const title = `Шини та диски R16 у ${city.nameLocative} — купити`;
const description = `Шини та диски радіусів R13–R20, зокрема R16, для клієнтів з ${city.nameLocative}. ${city.intro}`;

const faqItems = [city.extraFaq, ...kolisa.faq];
const ctaLabel = kolisa.ctaLabel ?? 'Підібрати колеса';
const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({ ...kolisa, title, description, areaServed: city.name }, path),
];
const faq = faqSchema(faqItems);
if (faq) schema.push(faq);

const otherCities = KOLISA_CITIES.filter((c) => c.slug !== city.slug);
---

<Layout title={title} description={description} path={path} schema={schema} serviceSlug={`prodazh-kolis-${city.slug}`}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero container" data-animate>
    <p class="eyebrow"><Icon name="tire" size={16} /> Шини та диски</p>
    <h1>Шини та диски R16 у {city.nameLocative}</h1>
    <p class="lead">{city.intro}</p>
    <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
      <Icon name="phone" size={18} /> {ctaLabel}
    </a>
  </section>

  <section class="container info-row" data-animate>
    <div class="info-card">
      <span class="info-card__label">Відстань до СТО</span>
      <strong>{city.distanceKm}</strong>
      <span class="info-card__note">від с. Рудники</span>
    </div>
    <div class="info-card">
      <span class="info-card__label">Маршрут</span>
      <strong class="info-card__text">{city.road}</strong>
    </div>
    <div class="info-card">
      <span class="info-card__label">Радіуси в наявності</span>
      <strong>R13–R20</strong>
      <span class="info-card__note">включно з R16</span>
    </div>
  </section>

  <section class="container">
    <ContactCard member={responsible} eyebrow="Потрібні шини чи диски?" ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={faqItems} />
  </section>

  <section class="container other-cities" data-animate>
    <h2>Також обслуговуємо:</h2>
    <div class="other-cities__list">
      <a href="/poslugy/prodazh-kolis">Рудники (база)</a>
      {otherCities.map((c) => (
        <a href={`/poslugy/prodazh-kolis/${c.slug}`}>{c.name}</a>
      ))}
    </div>
  </section>

  {kolisa.related && <RelatedServices slugs={kolisa.related} />}
</Layout>

<style>
  .hero {
    max-width: 700px;
    padding-block: var(--space-6);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--color-gray-mid);
    margin-bottom: var(--space-4);
  }

  .info-row {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .info-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .info-card:not(:first-child) {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-4);
    }
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-card__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .info-card strong {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 700;
  }

  .info-card__text {
    font-size: var(--fs-base);
    font-weight: 700;
  }

  .info-card__note {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .other-cities {
    padding-block: var(--space-5) var(--space-7);
  }

  .other-cities__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .other-cities__list a {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-black);
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .other-cities__list a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
