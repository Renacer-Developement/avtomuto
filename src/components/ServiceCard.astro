---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/poslugy/${service.slug}`}
  class={`service-card ${service.highlight ? 'service-card--highlight' : ''}`}
  aria-label={service.title}
  data-animate
>
  <span class="service-card__icon" aria-hidden="true">
    <Icon name={service.icon} size={28} />
  </span>
  <h3 class="service-card__title">{service.title}</h3>
  <p class="service-card__desc">{service.shortDescription}</p>
  <span class="service-card__more" aria-hidden="true">
    Детальніше <Icon name="arrow" size={16} />
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-black);
    background: var(--color-white);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .service-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .service-card--highlight {
    background: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  .service-card--highlight .service-card__icon {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .service-card__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: var(--color-gray-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-card__title {
    font-size: var(--fs-lg);
    margin: 0;
  }

  .service-card__desc {
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
    margin: 0;
    flex: 1;
  }

  .service-card--highlight .service-card__desc {
    color: #d9d9d9;
  }

  .service-card__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 700;
    color: var(--color-accent);
    font-size: var(--fs-sm);
  }
</style>
