---
interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  steps: Step[];
}

const { title, steps } = Astro.props;
---

<section class="container process" data-animate>
  <h2>{title}</h2>
  <ol class="process__list" style={`--process-cols: ${steps.length}`}>
    {steps.map((step, i) => (
      <li class="process__step">
        <span class="process__number">{i + 1}</span>
        <div>
          <p class="process__step-title">{step.title}</p>
          <p class="process__step-text">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .process {
    padding-block: var(--space-6);
  }

  .process__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .process__list {
      grid-template-columns: repeat(var(--process-cols, 4), 1fr);
      gap: var(--space-3);
    }
  }

  .process__step {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .process__step {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  .process__number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-white);
    font-weight: 800;
    font-size: var(--fs-base);
  }

  .process__step-title {
    margin: 0 0 var(--space-1);
    font-weight: 700;
  }

  .process__step-text {
    margin: 0;
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }
</style>
