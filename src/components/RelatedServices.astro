---
import Icon from './Icon.astro';
import { getServiceBySlug } from '../data/services';

interface Props {
  slugs: string[];
  heading?: string;
}

const { slugs, heading = 'Суміжні послуги' } = Astro.props;
const items = slugs
  .map((slug) => getServiceBySlug(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---

{items.length > 0 && (
  <section class="related-services container" data-animate>
    <p class="eyebrow">Далі може знадобитись</p>
    <h2>{heading}</h2>
    <div class="related-services__list">
      {items.map((service) => (
        <a href={`/poslugy/${service.slug}`} class="related-services__row">
          <Icon name={service.icon} size={20} class="related-services__icon" />
          <span class="related-services__body">
            <strong>{service.title}</strong>
            <span class="related-services__desc">{service.shortDescription}</span>
          </span>
          <Icon name="arrow" size={18} class="related-services__arrow" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-services {
    padding-block: var(--space-5) var(--space-6);
  }

  .related-services .eyebrow {
    margin-bottom: var(--space-2);
  }

  .related-services__list {
    margin-top: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .related-services__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-black);
  }

  .related-services__row :global(.related-services__icon) {
    color: var(--color-accent);
    margin-top: 3px;
    flex-shrink: 0;
  }

  .related-services__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .related-services__row strong {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-lg);
  }

  .related-services__desc {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .related-services__row :global(.related-services__arrow) {
    color: var(--color-gray-mid);
    margin-top: 5px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
  }

  .related-services__row:hover :global(.related-services__arrow) {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .related-services__row :global(.related-services__icon),
    .related-services__row :global(.related-services__arrow) {
      display: none;
    }

    .related-services__row {
      grid-template-columns: 1fr;
    }
  }
</style>
