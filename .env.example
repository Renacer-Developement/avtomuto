# Telegram Bot (для форми зворотного зв'язку на /kontakty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Tag Manager / Analytics
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads (конверсії)
PUBLIC_GOOGLE_ADS_ID=

# Google Search Console verification
PUBLIC_GSC_VERIFICATION=

# Hygraph CMS (блог + авто в наявності) — опційно.
# Без цих змінних сайт використовує вбудований локальний контент (src/data/blog.ts,
# src/lib/cars.ts) і збирається нормально. Content API endpoint береться з
# Hygraph Studio → Project settings → API access → Content API. HYGRAPH_TOKEN потрібен
# лише якщо Content API не публічний (Permanent Auth Token з правом Read).
HYGRAPH_ENDPOINT=https://us-west-2.cdn.hygraph.com/content/cms1zpd7y01pd07uz1h8a2ysb/master
HYGRAPH_TOKEN=
