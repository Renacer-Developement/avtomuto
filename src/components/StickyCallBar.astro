---
import Icon from './Icon.astro';
import { TEAM, telHref } from '../data/site';
---

<div class="sticky-cta" aria-hidden="false">
  <a
    href={telHref(TEAM.andriy.phone)}
    class="sticky-cta__fab"
    data-gtm-event="click_phone"
    data-team-member={TEAM.andriy.name}
    aria-label={`Викликати евакуатор — ${TEAM.andriy.phone}, цілодобово`}
  >
    <span class="sticky-cta__pulse" aria-hidden="true"></span>
    <Icon name="tow-truck" size={22} />
    <span class="sticky-cta__label">
      Евакуатор
      <small>24/7 — дзвонити</small>
    </span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: 150;
  }

  .sticky-cta__fab {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 56px;
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--color-black);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
    transition: transform var(--transition-fast);
  }

  .sticky-cta__fab:active {
    transform: scale(0.95);
  }

  .sticky-cta__label {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    white-space: nowrap;
  }

  .sticky-cta__label small {
    font-weight: 600;
    font-size: 0.72rem;
    color: var(--color-accent);
  }

  .sticky-cta__pulse {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--color-accent);
    opacity: 0.55;
    z-index: -1;
    animation: sticky-cta-pulse 2.2s ease-out infinite;
  }

  @keyframes sticky-cta-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70% {
      transform: scale(1.35);
      opacity: 0;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta__pulse {
      animation: none;
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
