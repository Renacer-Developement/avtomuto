---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import ContactCard from '../../../components/ContactCard.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import { TEAM, telHref } from '../../../data/site';
import { TEAM_PHOTOS } from '../../../data/team-photos';
import { SERVICE_PHOTOS } from '../../../data/service-photos';
import {
  EVAKUATOR_CITIES,
  EVAKUATOR_DIRECTIONS,
  getEvakuatorCityBySlug,
  getEvakuatorCitiesByDirection,
} from '../../../data/evakuator-cities';
import { getBlogPosts } from '../../../data/blog';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../utils/schema';

const service = getServiceBySlug('evakuator')!;
const responsible = TEAM[service.responsible];
const responsiblePhoto = TEAM_PHOTOS[service.responsible];
const servicePhoto = SERVICE_PHOTOS[service.slug];
const path = '/poslugy/evakuator';
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: path },
];
const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema(service, path, {
    areaServedList: [...EVAKUATOR_CITIES.map((c) => c.name), 'Львівська область'],
    allDay: true,
  }),
];
const faq = faqSchema(service.faq);
if (faq) schema.push(faq);
const ctaLabel = service.ctaLabel ?? "Зв'язатись з менеджером";

const benefitIcons = ['clock', 'region', 'tow-truck', 'phone'];

// Радіальна діаграма покриття — координати вузлів у SVG viewBox 0 0 500 400.
const coverageNodes = [
  { city: getEvakuatorCityBySlug('stryi')!, x: 140, y: 220 },
  { city: getEvakuatorCityBySlug('drohobych')!, x: 320, y: 150 },
  { city: getEvakuatorCityBySlug('lviv')!, x: 420, y: 60 },
];

const directionGroups = EVAKUATOR_DIRECTIONS.map((d) => ({
  ...d,
  cities: getEvakuatorCitiesByDirection(d.key),
}));

const posts = await getBlogPosts();
const relatedPosts = posts.filter((p) => p.relatedServiceSlug === service.slug);
---

<Layout
  title={service.metaTitle ?? service.title}
  description={service.metaDescription ?? service.shortDescription}
  path={path}
  schema={schema}
  serviceSlug={service.slug}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero" data-animate>
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="hero__badge">24/7</span>
        <p class="eyebrow">
          <Icon name={service.icon} size={16} /> Послуга
        </p>
        <h1>Евакуатор 24/7 по Львівській області</h1>
        <p class="lead">{service.description}</p>
        <a href={telHref(responsible.phone)} class="hero__cta" data-gtm-event="click_phone">
          <Icon name="phone" size={20} /> {ctaLabel}
        </a>
      </div>
      {servicePhoto && (
        <figure class="hero__media">
          <div class="offset-block offset-block--ink">
            <Image src={servicePhoto} alt={service.title} width={640} height={480} format="avif" quality={80} fit="cover" loading="eager" fetchpriority="high" />
          </div>
        </figure>
      )}
    </div>
  </section>

  <section class="container coverage" data-animate>
    <p class="eyebrow">{service.areaServed ?? 'Львівська область'}</p>
    <h2>Виїжджаємо по всій області</h2>
    <div class="coverage__diagram">
      <svg viewBox="0 0 500 260" fill="none" xmlns="http://www.w3.org/2000/svg" class="coverage__svg">
        {coverageNodes.map((n) => (
          <line x1="60" y1="230" x2={n.x} y2={n.y} stroke="var(--color-border)" stroke-width="2.5" stroke-dasharray="8 7" />
        ))}
        <circle cx="60" cy="230" r="20" fill="#141414" />
        <text x="60" y="235" text-anchor="middle" fill="var(--color-white)" font-family="var(--font-mono)" font-size="9" font-weight="700">СТО</text>
        {coverageNodes.map((n) => (
          <circle cx={n.x} cy={n.y} r="13" fill="var(--color-accent)" />
        ))}
      </svg>
      <div class="coverage__labels">
        <div class="coverage__base">
          <strong>Рудники</strong>
          <span>База евакуатора</span>
        </div>
        <div class="coverage__cities">
          {coverageNodes.map((n) => (
            <a href={`/poslugy/evakuator/${n.city.slug}`} class="coverage__city">
              <Icon name="map-pin" size={18} />
              <span class="coverage__city-body">
                <strong>{n.city.name}</strong>
              </span>
              <Icon name="arrow" size={16} class="coverage__city-arrow" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container places" data-animate>
    <h2>Евакуатор по населених пунктах</h2>
    <div class="places__grid">
      {directionGroups.map((group) => (
        <div class="places__group">
          <h3>{group.title}</h3>
          <ul>
            {group.cities.map((c) => (
              <li><a href={`/poslugy/evakuator/${c.slug}`}>Евакуатор {c.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="benefits" data-animate>
    <div class="container">
      <p class="eyebrow">{service.benefitsHeading ?? 'Переваги послуги'}</p>
      <div class="benefits__row">
        {service.benefits.map((item, i) => (
          <div class="benefits__item">
            <Icon name={benefitIcons[i] ?? 'check'} size={26} class="benefits__icon" />
            <p>{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container" data-animate>
    <ContactCard member={responsible} photo={responsiblePhoto} ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={service.faq} />
  </section>

  {relatedPosts.length > 0 && (
    <section class="container blog-links" data-animate>
      <h2>Статті по темі</h2>
      <div class="blog-links__list">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-links__card">
            <strong>{post.title}</strong>
            <span>{post.excerpt}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {service.related && <RelatedServices slugs={service.related} />}

  <section class="final-cta" data-animate>
    <div class="container final-cta__inner">
      <p class="eyebrow">Авто зламалося просто зараз?</p>
      <h2>Телефонуйте — евакуатор виїде негайно</h2>
      <p>Цілодобово, без вихідних, по всій Львівській області. Прямий дзвінок відповідальному, без кол-центру.</p>
      <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
        <Icon name="phone" size={18} /> {ctaLabel}
      </a>
    </div>
  </section>
</Layout>

<style>
  section {
    padding-block: var(--space-5);
  }

  .hero {
    background: var(--color-accent);
    color: var(--color-white);
    padding-block: var(--space-7);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6) var(--space-7);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 6fr 6fr;
      align-items: center;
    }
  }

  .hero__text {
    position: relative;
  }

  .hero__badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(3.5rem, 3rem + 3vw, 5.5rem);
    line-height: 1;
    color: var(--color-black);
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero .eyebrow {
    color: var(--color-black);
    margin-bottom: var(--space-2);
  }

  .lead {
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .hero .lead {
    color: rgba(20, 20, 20, 0.8);
    font-weight: 600;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-black);
    color: var(--color-white);
    font-weight: 700;
    padding: var(--space-3) var(--space-5);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .hero__cta:hover {
    background: #000;
  }

  .hero__media .offset-block {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .coverage .eyebrow {
    margin-bottom: var(--space-2);
  }

  .coverage__diagram {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 800px) {
    .coverage__diagram {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }
  }

  .coverage__svg {
    width: 100%;
    height: auto;
  }

  .coverage__labels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .coverage__base {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .coverage__base strong {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
  }

  .coverage__base span {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
  }

  .coverage__cities {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .coverage__city {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-black);
  }

  .coverage__city :global(svg:first-child) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .coverage__city-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
  }

  .coverage__city-body span {
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
  }

  .coverage__city :global(.coverage__city-arrow) {
    color: var(--color-gray-mid);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
  }

  .coverage__city:hover :global(.coverage__city-arrow) {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  .places__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .places__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .places__group h3 {
    font-size: var(--fs-base);
    margin-bottom: var(--space-2);
    color: var(--color-accent);
  }

  .places__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-4);
  }

  .places__group li {
    padding-block: 4px;
    break-inside: avoid;
  }

  .places__group a {
    color: var(--color-black);
    text-decoration: none;
    font-size: var(--fs-sm);
  }

  .places__group a:hover {
    color: var(--color-accent);
  }

  .benefits {
    background: var(--color-black);
    color: var(--color-white);
  }

  .benefits .eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .benefits__row {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .benefits__row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .benefits__item :global(.benefits__icon) {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .benefits__item p {
    margin: 0;
    font-weight: 600;
  }

  .blog-links__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .blog-links__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-links__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    text-decoration: none;
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .blog-links__card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .blog-links__card span {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .final-cta {
    background: var(--color-gray-light);
    padding-block: var(--space-7);
    margin-top: var(--space-6);
  }

  .final-cta__inner {
    max-width: 60ch;
  }

  .final-cta .eyebrow {
    margin-bottom: var(--space-2);
  }

  .final-cta p:not(.eyebrow) {
    color: var(--color-gray-mid);
  }

  .final-cta .btn {
    margin-top: var(--space-4);
  }
</style>
