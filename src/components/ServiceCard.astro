---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  index?: number;
}

const { service, index } = Astro.props;
const num = index != null ? String(index + 1).padStart(2, '0') : null;
---

<a href={`/poslugy/${service.slug}`} class="service-row" data-animate>
  {num && <span class="service-row__num" aria-hidden="true">{num}</span>}
  <Icon name={service.icon} size={22} class="service-row__icon" />
  <span class="service-row__body">
    <span class="service-row__title">{service.title}</span>
    <span class="service-row__desc">{service.shortDescription}</span>
  </span>
  <Icon name="arrow" size={18} class="service-row__arrow" />
</a>

<style>
  .service-row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: start;
    gap: var(--space-3) var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-black);
    break-inside: avoid;
  }

  .service-row__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-lg);
    color: #bdbdbd;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .service-row:hover .service-row__num {
    color: var(--color-accent);
  }

  .service-row :global(.service-row__icon) {
    color: var(--color-accent);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .service-row__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .service-row__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-lg);
  }

  .service-row__desc {
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
  }

  .service-row :global(.service-row__arrow) {
    color: var(--color-gray-mid);
    margin-top: 6px;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
  }

  .service-row:hover :global(.service-row__arrow) {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .service-row {
      grid-template-columns: auto 1fr;
    }

    .service-row :global(.service-row__icon),
    .service-row :global(.service-row__arrow) {
      display: none;
    }
  }
</style>
