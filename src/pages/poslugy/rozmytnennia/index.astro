---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import ContactCard from '../../../components/ContactCard.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import { TEAM, telHref } from '../../../data/site';
import { TEAM_PHOTOS } from '../../../data/team-photos';
import { SERVICE_PHOTOS } from '../../../data/service-photos';
import { getBlogPosts } from '../../../data/blog';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../utils/schema';

const service = getServiceBySlug('rozmytnennia')!;
const responsible = TEAM[service.responsible];
const responsiblePhoto = TEAM_PHOTOS[service.responsible];
const servicePhoto = SERVICE_PHOTOS[service.slug];
const path = '/poslugy/rozmytnennia';
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: path },
];
const schema = [breadcrumbSchema(crumbs), serviceSchema(service, path)];
const faq = faqSchema(service.faq);
if (faq) schema.push(faq);
const ctaLabel = service.ctaLabel ?? "Зв'язатись з менеджером";

const stepIcons = ['calculator', 'folder', 'customs', 'key'];
const benefitIcons = ['calculator', 'folder', 'customs'];

const posts = await getBlogPosts();
const relatedPosts = posts.filter((p) => p.relatedServiceSlug === service.slug);
---

<Layout
  title={service.title}
  description={service.shortDescription}
  path={path}
  schema={schema}
  serviceSlug={service.slug}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero" data-animate>
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow"><Icon name={service.icon} size={16} /> Послуга</p>
        <h1>{service.title}</h1>
        <p class="lead">{service.description}</p>
        <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
          <Icon name="phone" size={18} /> {ctaLabel}
        </a>
      </div>
      {servicePhoto && (
        <figure class="hero__media">
          <div class="offset-block">
            <Image src={servicePhoto} alt={service.title} width={640} height={480} format="avif" quality={80} fit="cover" loading="eager" fetchpriority="high" />
          </div>
        </figure>
      )}
    </div>
  </section>

  {service.processSteps && (
    <section class="container timeline" data-animate>
      <p class="eyebrow">Як проходить розмитнення</p>
      <h2>Чотири кроки до отримання авто</h2>
      <ol class="timeline__list">
        {service.processSteps.map((step, i) => (
          <li class="timeline__step">
            <span class="timeline__node">
              <Icon name={stepIcons[i] ?? 'check'} size={22} />
            </span>
            <div class="timeline__body">
              <span class="timeline__num">Крок {i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="container benefits" data-animate>
    <p class="eyebrow">{service.benefitsHeading ?? 'Переваги послуги'}</p>
    <h2>Чому нам довіряють розмитнення</h2>
    <ul class="benefits__list">
      {service.benefits.map((item, i) => (
        <li>
          <Icon name={benefitIcons[i] ?? 'check'} size={22} class="benefits__icon" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container" data-animate>
    <ContactCard member={responsible} photo={responsiblePhoto} ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={service.faq} />
  </section>

  {relatedPosts.length > 0 && (
    <section class="container blog-links" data-animate>
      <h2>Статті по темі</h2>
      <div class="blog-links__list">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-links__card">
            <strong>{post.title}</strong>
            <span>{post.excerpt}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {service.related && <RelatedServices slugs={service.related} />}

  <section class="final-cta" data-animate>
    <div class="container final-cta__inner">
      <p class="eyebrow">Плануєте пригнати авто?</p>
      <h2>Розрахуємо митні платежі ще до поїздки на митницю</h2>
      <p>Зателефонуйте Володимиру — назве орієнтовну суму й підкаже, які документи підготувати заздалегідь.</p>
      <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
        <Icon name="phone" size={18} /> {ctaLabel}
      </a>
    </div>
  </section>
</Layout>

<style>
  section {
    padding-block: var(--space-5);
  }

  .hero {
    background: var(--color-black);
    color: var(--color-white);
    padding-block: var(--space-7);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6) var(--space-7);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 5fr 7fr;
      align-items: center;
    }
  }

  .hero h1 {
    color: var(--color-white);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .lead {
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }

  .hero .lead {
    color: #b5b5b5;
  }

  .hero__media .offset-block {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .hero__media .offset-block::before {
    background: var(--color-accent);
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .timeline .eyebrow {
    margin-bottom: var(--space-2);
  }

  .timeline__list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    position: relative;
  }

  .timeline__list::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 21px;
    width: 2px;
    background: var(--color-border);
  }

  @media (min-width: 640px) {
    .timeline__list::before {
      left: 25px;
    }
  }

  .timeline__step {
    position: relative;
    display: flex;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .timeline__step:last-child {
    padding-bottom: 0;
  }

  .timeline__node {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-white);
    border: 2px solid var(--color-black);
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .timeline__node {
      width: 52px;
      height: 52px;
    }
  }

  .timeline__body {
    padding-top: var(--space-1);
  }

  .timeline__num {
    display: block;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-1);
  }

  .timeline__body h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-1);
  }

  .timeline__body p {
    margin: 0;
    color: var(--color-gray-mid);
    max-width: 55ch;
  }

  .benefits .eyebrow {
    margin-bottom: var(--space-2);
  }

  .benefits__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 70ch;
    border-top: 1px solid var(--color-border);
  }

  .benefits__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
  }

  .benefits__list :global(.benefits__icon) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .blog-links__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .blog-links__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-links__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    text-decoration: none;
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .blog-links__card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .blog-links__card span {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .final-cta {
    background: var(--color-gray-light);
    padding-block: var(--space-7);
    margin-top: var(--space-6);
  }

  .final-cta__inner {
    max-width: 60ch;
  }

  .final-cta .eyebrow {
    margin-bottom: var(--space-2);
  }

  .final-cta p:not(.eyebrow) {
    color: var(--color-gray-mid);
  }

  .final-cta .btn {
    margin-top: var(--space-4);
  }
</style>
