---
import CarCard from './CarCard.astro';
import { getCarListings } from '../lib/cars';
import type { TeamMember } from '../data/site';

interface Props {
  responsible: TeamMember;
}

const { responsible: _responsible } = Astro.props;
// На головній показуємо лише авто в наявності — продані чи ще не привезені
// сюди не потрапляють. Якщо таких немає, секцію ховаємо повністю замість
// показувати порожній стан.
const cars = (await getCarListings()).filter((c) => c.status === 'available').slice(0, 3);
---

{cars.length > 0 && (
  <section class="featured-cars" aria-label="Продаж автомобілів" data-animate>
    <div class="container">
      <div class="featured-cars__head">
        <div>
          <p class="featured-cars__eyebrow">Продаж авто</p>
          <h2>Автомобілі в наявності</h2>
          <p class="featured-cars__desc">Перевірені авто під ключ: підбір, огляд, оформлення. Онови авто вже цього тижня.</p>
        </div>
        <a href="/poslugy/prodaz-auto" class="btn btn-outline featured-cars__all">Усі авто в наявності</a>
      </div>

      <div class="featured-cars__list">
        {cars.map((car) => (
          <CarCard car={car} layout="list" hideStatus />
        ))}
      </div>

      <a href="/poslugy/prodaz-auto" class="btn btn-outline featured-cars__all featured-cars__all--mobile">Усі авто в наявності</a>
    </div>
  </section>
)}

<style>
  .featured-cars {
    padding-block: var(--space-7);
    background: var(--color-gray-light);
  }

  .featured-cars__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 768px) {
    .featured-cars__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .featured-cars__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--fs-sm);
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .featured-cars__head h2 {
    margin-bottom: var(--space-2);
  }

  .featured-cars__desc {
    color: var(--color-gray-mid);
    max-width: 52ch;
    margin-bottom: 0;
  }

  .featured-cars__all {
    flex-shrink: 0;
    color: var(--color-black);
    border-color: var(--color-black);
  }

  .featured-cars__all:hover,
  .featured-cars__all:focus-visible {
    background: var(--color-black);
    color: var(--color-white);
  }

  .featured-cars__all--mobile {
    display: flex;
    width: 100%;
    margin-top: var(--space-5);
  }

  @media (min-width: 768px) {
    .featured-cars__all--mobile {
      display: none;
    }
  }

  .featured-cars__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .featured-cars__empty {
    padding: var(--space-5);
    background: var(--color-white);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .featured-cars__empty p {
    max-width: 55ch;
    margin-inline: auto;
    color: var(--color-gray-mid);
    margin-bottom: var(--space-4);
  }

  .featured-cars__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
