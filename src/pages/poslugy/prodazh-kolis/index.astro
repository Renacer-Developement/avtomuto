---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import ContactCard from '../../../components/ContactCard.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import { TEAM, telHref } from '../../../data/site';
import { TEAM_PHOTOS } from '../../../data/team-photos';
import { SERVICE_PHOTOS } from '../../../data/service-photos';
import { KOLISA_CITIES } from '../../../data/kolisa-cities';
import { getBlogPosts } from '../../../data/blog';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../utils/schema';

const service = getServiceBySlug('prodazh-kolis')!;
const responsible = TEAM[service.responsible];
const responsiblePhoto = TEAM_PHOTOS[service.responsible];
const servicePhoto = SERVICE_PHOTOS[service.slug];
const path = '/poslugy/prodazh-kolis';
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: path },
];
const schema = [breadcrumbSchema(crumbs), serviceSchema(service, path)];
const faq = faqSchema(service.faq);
if (faq) schema.push(faq);
const ctaLabel = service.ctaLabel ?? 'Підібрати колеса';

const radii = ['R13', 'R14', 'R15', 'R16', 'R17', 'R18', 'R19', 'R20'];

const seasonIcons = ['sun', 'snowflake', 'cycle'];

const benefitIcons = ['parts', 'tire', 'cycle', 'wrench', 'check'];

const posts = await getBlogPosts();
const relatedPosts = posts.filter((p) => p.relatedServiceSlug === service.slug);
---

<Layout
  title={service.title}
  description={service.shortDescription}
  path={path}
  schema={schema}
  serviceSlug={service.slug}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero" data-animate>
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="index-mark hero__index" aria-hidden="true">01</span>
        <p class="eyebrow"><Icon name="tire" size={16} /> Товар</p>
        <h1>{service.title}</h1>
        <p class="lead">{service.description}</p>
        <ul class="radii" aria-label="Доступні радіуси">
          {radii.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
        <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
          <Icon name="phone" size={18} /> {ctaLabel}
        </a>
      </div>
      {servicePhoto && (
        <figure class="hero__media">
          <div class="offset-block">
            <Image src={servicePhoto} alt={service.title} width={640} height={480} format="avif" quality={80} fit="cover" loading="eager" fetchpriority="high" />
          </div>
        </figure>
      )}
    </div>
  </section>

  <section class="container seasons" data-animate>
    <span class="index-mark seasons__index" aria-hidden="true">02</span>
    <p class="eyebrow">{service.optionCardsHeading ?? 'Який сезон обрати'}</p>
    <h2>Оберіть сезон гуми</h2>
    <div class="seasons__grid">
      {(service.optionCards ?? []).map((opt, i) => (
        <div class="season-tile">
          <Icon name={seasonIcons[i] ?? 'tire'} size={32} class="season-tile__icon" />
          <h3>{opt.title}</h3>
          <p>{opt.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container benefits" data-animate>
    <span class="index-mark benefits__index" aria-hidden="true">03</span>
    <p class="eyebrow">{service.benefitsHeading ?? 'Чому обирають наші колеса'}</p>
    <h2>Переваги</h2>
    <ul class="benefits__list">
      {service.benefits.map((item, i) => (
        <li>
          <Icon name={benefitIcons[i] ?? 'check'} size={22} class="benefits__icon" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container" data-animate>
    <ContactCard member={responsible} photo={responsiblePhoto} ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={service.faq} />
  </section>

  <section class="container cities" data-animate>
    <p class="eyebrow">Виїзд по регіону</p>
    <h2>Шини та диски по містах</h2>
    <p class="lead">Радіуси R13–R20, зокрема R16, з підбором і встановленням на СТО в Рудниках:</p>
    <div class="cities__list">
      {KOLISA_CITIES.map((c) => (
        <a href={`/poslugy/prodazh-kolis/${c.slug}`} class="city-row">
          <Icon name="map-pin" size={20} class="city-row__icon" />
          <span class="city-row__body">
            <span class="city-row__name">Шини та диски у {c.nameLocative}</span>
            <span class="city-row__distance">{c.distanceKm} від Рудників</span>
          </span>
          <Icon name="arrow" size={18} class="city-row__arrow" />
        </a>
      ))}
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="container blog-links" data-animate>
      <h2>Статті по темі</h2>
      <div class="blog-links__list">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-links__card">
            <strong>{post.title}</strong>
            <span>{post.excerpt}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {service.related && <RelatedServices slugs={service.related} />}

  <section class="final-cta" data-animate>
    <div class="container final-cta__inner">
      <p class="eyebrow">Готові підібрати колеса?</p>
      <h2>Зателефонуйте — підберемо розмір і сезон під ваше авто</h2>
      <p>Назвемо орієнтовну ціну ще до приїзду на СТО, а балансування та встановлення виконаємо одразу на місці.</p>
      <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
        <Icon name="phone" size={18} /> {ctaLabel}
      </a>
    </div>
  </section>
</Layout>

<style>
  section {
    padding-block: var(--space-5);
  }

  .hero {
    position: relative;
    padding-block: var(--space-6);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6) var(--space-7);
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }

  .hero__text {
    position: relative;
    padding-top: var(--space-3);
  }

  .hero__index {
    position: absolute;
    top: -1.6rem;
    left: -0.2rem;
    z-index: -1;
  }

  .lead {
    color: var(--color-gray-mid);
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }

  .radii {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
  }

  .radii li {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--fs-sm);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-gray-mid);
  }

  .hero__media .offset-block {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seasons,
  .benefits {
    position: relative;
  }

  .seasons__index,
  .benefits__index {
    position: absolute;
    top: var(--space-4);
    right: 0;
    z-index: -1;
  }

  .seasons .eyebrow,
  .benefits .eyebrow {
    margin-bottom: var(--space-2);
  }

  .seasons__grid {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 700px) {
    .seasons__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .season-tile {
    padding: var(--space-5) var(--space-3) var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 700px) {
    .season-tile {
      border-bottom: none;
      padding-inline: var(--space-4);
    }

    .season-tile:first-child {
      padding-left: 0;
    }

    .season-tile:not(:first-child) {
      border-left: 1px solid var(--color-border);
    }
  }

  .season-tile :global(.season-tile__icon) {
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .season-tile h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--space-2);
  }

  .season-tile p {
    margin: 0;
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .benefits__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    max-width: 70ch;
    border-top: 1px solid var(--color-border);
  }

  .benefits__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
  }

  .benefits__list :global(.benefits__icon) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .cities .lead {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .cities__list {
    border-top: 1px solid var(--color-border);
  }

  .city-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-black);
  }

  .city-row :global(.city-row__icon) {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .city-row__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .city-row__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-lg);
  }

  .city-row__distance {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-gray-mid);
  }

  .city-row :global(.city-row__arrow) {
    color: var(--color-gray-mid);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
  }

  .city-row:hover :global(.city-row__arrow) {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-accent);
  }

  .blog-links__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .blog-links__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-links__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    text-decoration: none;
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .blog-links__card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .blog-links__card span {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .final-cta {
    background: var(--color-gray-light);
    padding-block: var(--space-7);
    margin-top: var(--space-6);
  }

  .final-cta__inner {
    max-width: 60ch;
  }

  .final-cta .eyebrow {
    margin-bottom: var(--space-2);
  }

  .final-cta p:not(.eyebrow) {
    color: var(--color-gray-mid);
  }

  .final-cta .btn {
    margin-top: var(--space-4);
  }
</style>
