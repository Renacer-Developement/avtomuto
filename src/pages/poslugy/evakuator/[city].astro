---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqAccordion from '../../../components/FaqAccordion.astro';
import Icon from '../../../components/Icon.astro';
import ContactCard from '../../../components/ContactCard.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { getServiceBySlug } from '../../../data/services';
import {
  EVAKUATOR_CITIES,
  getEvakuatorCitiesByDirection,
  getEvakuatorDirection,
} from '../../../data/evakuator-cities';
import { TEAM, telHref } from '../../../data/site';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../../utils/schema';

export function getStaticPaths() {
  return EVAKUATOR_CITIES.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const evakuator = getServiceBySlug('evakuator')!;
const responsible = TEAM[evakuator.responsible];
const path = `/poslugy/evakuator/${city.slug}`;

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: evakuator.title, href: '/poslugy/evakuator' },
  { label: city.name, href: path },
];

// Називний відмінок у title — під запити типу «евакуатор дроговиж».
const title = `Евакуатор ${city.name} — виклик 24/7 у ${city.nameLocative}`;
const description = `Евакуатор ${city.name} — цілодобовий виклик у ${city.nameLocative} та поруч. Виїзд з бази в Рудниках, дзвінок напряму водію, ціну називаємо до виїзду.`;
const direction = getEvakuatorDirection(city.direction);

// Повний загальний FAQ живе на /poslugy/evakuator. Тут — питання міста + 2 загальні,
// які чергуються між сторінками, щоб спільного тексту було якомога менше.
const cityIndex = EVAKUATOR_CITIES.indexOf(city);
const generalFaq = evakuator.faq;
// Не дублюємо тему, яку вже покриває питання міста (ціна, супровід, ДТП…).
const FAQ_TOPICS = ['коштує', 'разом', 'ДТП', 'відвозите', 'швидко'];
const topicOf = (q: string) => FAQ_TOPICS.find((t) => q.includes(t));
const cityTopic = topicOf(city.extraFaq.question);
const generalPicks = generalFaq
  .map((_, i) => generalFaq[(cityIndex * 2 + i) % generalFaq.length])
  .filter((item) => !cityTopic || topicOf(item.question) !== cityTopic)
  .slice(0, 2);
const faqItems = [city.extraFaq, ...generalPicks];
const ctaLabel = evakuator.ctaLabel ?? 'Викликати евакуатор';
const schema = [
  breadcrumbSchema(crumbs),
  serviceSchema({ ...evakuator, title, description, areaServed: city.name }, path),
];
const faq = faqSchema(faqItems);
if (faq) schema.push(faq);

// Лише найближчі сусіди по маршруту (порядок у масиві ≈ порядок уздовж дороги), а не всі
// 50 пунктів: однаковий список на кожній сторінці — ознака doorway pages. Повний перелік — на хабі.
const routeCities = getEvakuatorCitiesByDirection(city.direction);
const routeIndex = routeCities.indexOf(city);
const NEIGHBOR_SPAN = 3;
const neighbors = routeCities
  .slice(Math.max(0, routeIndex - NEIGHBOR_SPAN), routeIndex + NEIGHBOR_SPAN + 1)
  .filter((c) => c.slug !== city.slug);
---

<Layout title={title} description={description} path={path} schema={schema} serviceSlug={`evakuator-${city.slug}`}>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero container" data-animate>
    <p class="eyebrow"><Icon name="tow-truck" size={16} /> Евакуатор · 24/7</p>
    <h1>Евакуатор у {city.nameLocative}</h1>
    <p class="lead">{city.intro}</p>
    <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
      <Icon name="phone" size={18} /> {ctaLabel}
    </a>
  </section>

  <section class="container info-row" data-animate>
    {city.distanceKm ? (
      <div class="info-card">
        <span class="info-card__label">Відстань від бази</span>
        <strong>{city.distanceKm}</strong>
        <span class="info-card__note">від с. Рудники</span>
      </div>
    ) : (
      <div class="info-card">
        <span class="info-card__label">Напрямок виїзду</span>
        <strong class="info-card__text">{direction.title}</strong>
        <span class="info-card__note">база — с. Рудники</span>
      </div>
    )}
    <div class="info-card">
      <span class="info-card__label">Маршрут виїзду</span>
      <strong class="info-card__text">{city.road}</strong>
    </div>
    <div class="info-card">
      <span class="info-card__label">Графік</span>
      <strong>Цілодобово</strong>
      <span class="info-card__note">24/7, без вихідних</span>
    </div>
  </section>

  <section class="container note" data-animate>
    <p>{city.coverageNote}</p>
  </section>

  <section class="container">
    <ContactCard member={responsible} eyebrow="Потрібен евакуатор просто зараз?" ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={faqItems} />
  </section>

  <section class="container other-cities" data-animate>
    <h2>Також виїжджаємо в сусідні населені пункти</h2>
    <p class="other-cities__route">{direction.title}</p>
    <div class="other-cities__list">
      {neighbors.map((c) => (
        <a href={`/poslugy/evakuator/${c.slug}`}>Евакуатор {c.name}</a>
      ))}
    </div>
    <p class="other-cities__all"><a href="/poslugy/evakuator">Усі населені пункти й напрямки →</a></p>
  </section>

  {evakuator.related && <RelatedServices slugs={evakuator.related} />}
</Layout>

<style>
  .hero {
    max-width: 700px;
    padding-block: var(--space-6);
  }

  .hero .eyebrow {
    margin-bottom: var(--space-3);
  }

  .lead {
    color: var(--color-gray-mid);
    margin-bottom: var(--space-4);
  }

  .info-row {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .info-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .info-card:not(:first-child) {
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-4);
    }
  }

  .info-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .info-card__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .info-card strong {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 700;
  }

  .info-card__text {
    font-size: var(--fs-base);
    font-weight: 700;
  }

  .info-card__note {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .note {
    max-width: 700px;
    color: var(--color-gray-mid);
    padding-block: var(--space-3);
  }

  .other-cities {
    padding-block: var(--space-5) var(--space-7);
  }

  .other-cities__route {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .other-cities__all {
    margin-top: var(--space-4);
    font-weight: 600;
  }

  .other-cities__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .other-cities__list a {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-black);
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .other-cities__list a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
