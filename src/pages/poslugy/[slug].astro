---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import ContactCard from '../../components/ContactCard.astro';
import BenefitsGrid from '../../components/BenefitsGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import OptionCards from '../../components/OptionCards.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import { SERVICES } from '../../data/services';
import { TEAM, telHref } from '../../data/site';
import { TEAM_PHOTOS } from '../../data/team-photos';
import { SERVICE_PHOTOS } from '../../data/service-photos';
import { EVAKUATOR_CITIES } from '../../data/evakuator-cities';
import { getBlogPosts } from '../../data/blog';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../utils/schema';

// prodaz-auto має власну виділену сторінку-каталог (poslugy/prodaz-auto/index.astro),
// а не generic service-шаблон — так само як remont-avtomobiliv.
export function getStaticPaths() {
  return SERVICES.filter((s) => !s.hasSubcategories && s.slug !== 'prodaz-auto').map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const responsible = TEAM[service.responsible];
const responsiblePhoto = TEAM_PHOTOS[service.responsible];
const servicePhoto = SERVICE_PHOTOS[service.slug];
const path = `/poslugy/${service.slug}`;
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Послуги', href: '/poslugy' },
  { label: service.title, href: path },
];
const schema = [breadcrumbSchema(crumbs), serviceSchema(service, path)];
const faq = faqSchema(service.faq);
if (faq) schema.push(faq);

const ctaLabel = service.ctaLabel ?? "Зв'язатись з менеджером";
const benefitsHeading = service.benefitsHeading ?? (service.type === 'product' ? 'Чому обирають цей товар' : 'Переваги послуги');

const posts = await getBlogPosts();
const relatedPosts = posts.filter((p) => p.relatedServiceSlug === service.slug);
---

<Layout
  title={service.title}
  description={service.shortDescription}
  path={path}
  schema={schema}
  serviceSlug={service.slug}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
  </div>

  <section class="hero-service container" data-animate>
    <div class="hero-service__text">
      <div class={`hero-service__icon ${service.highlight ? 'hero-service__icon--highlight' : ''}`}>
        <Icon name={service.icon} size={32} />
      </div>
      <h1>{service.title}</h1>
      <p class="lead">{service.description}</p>
      <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
        <Icon name="phone" size={18} /> {ctaLabel}
      </a>
    </div>
    <div class="hero-service__media">
      {servicePhoto ? (
        <Image src={servicePhoto} alt={service.title} width={640} height={480} format="avif" quality={80} fit="cover" />
      ) : (
        <div class="hero-service__media-placeholder" aria-hidden="true">
          <span>Фото додається</span>
        </div>
      )}
    </div>
  </section>

  <BenefitsGrid heading={benefitsHeading} items={service.benefits} />

  {service.processSteps && (
    <ProcessSteps title="Як це відбувається" steps={service.processSteps} />
  )}

  {service.optionCards && (
    <OptionCards heading={service.optionCardsHeading ?? 'Варіанти'} items={service.optionCards} />
  )}

  <section class="container" data-animate>
    <ContactCard member={responsible} photo={responsiblePhoto} ctaLabel={ctaLabel} />
  </section>

  <section class="container">
    <FaqAccordion items={service.faq} />
  </section>

  {service.slug === 'evakuator' && (
    <section class="container cities-section" data-animate>
      <h2>Виїзд евакуатора по містах</h2>
      <p class="lead">Детальніше про виїзд, орієнтовний час прибуття та маршрут до кожного напрямку:</p>
      <div class="cities-section__list">
        {EVAKUATOR_CITIES.map((c) => (
          <a href={`/poslugy/evakuator/${c.slug}`} class="cities-section__card">
            <Icon name="map-pin" size={20} />
            <span>Евакуатор у {c.nameLocative}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="container blog-links" data-animate>
      <h2>Статті по темі</h2>
      <div class="blog-links__list">
        {relatedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-links__card">
            <strong>{post.title}</strong>
            <span>{post.excerpt}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {service.related && <RelatedServices slugs={service.related} />}

  <section class="final-cta" data-animate>
    <div class="container final-cta__inner">
      <h2>Готові розпочати?</h2>
      <p>Зателефонуйте нам — детально проконсультуємо саме щодо «{service.title.toLowerCase()}» і назвемо орієнтовні терміни.</p>
      <a href={telHref(responsible.phone)} class="btn btn-primary" data-gtm-event="click_phone">
        <Icon name="phone" size={18} /> {ctaLabel}
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero-service {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .hero-service {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .hero-service__icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background: var(--color-gray-light);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }

  .hero-service__icon--highlight {
    background: var(--color-black);
    color: var(--color-white);
  }

  .lead {
    color: var(--color-gray-mid);
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }

  .hero-service__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hero-service__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-service__media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border: 2px dashed var(--color-border);
    background: var(--color-gray-light);
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .cities-section {
    padding-block: var(--space-5);
  }

  .cities-section .lead {
    margin-bottom: var(--space-4);
  }

  .cities-section__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cities-section__card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-black);
    font-weight: 600;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .cities-section__card:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .blog-links {
    padding-block: var(--space-5);
  }

  .blog-links__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .blog-links__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .blog-links__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-black);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .blog-links__card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }

  .blog-links__card span {
    color: var(--color-gray-mid);
    font-size: var(--fs-sm);
  }

  .final-cta {
    background: var(--color-gray-light);
    padding-block: var(--space-7);
    margin-top: var(--space-6);
  }

  .final-cta__inner {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
  }

  .final-cta p {
    color: var(--color-gray-mid);
  }
</style>
